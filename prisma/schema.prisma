generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                   String    @id @default(uuid())
  clerkUserId          String    @unique // clerk user id
  email                String    @unique
  name                 String?
  imageUrl             String?
  transactions         Transaction[]
  accounts             Account[]
  budgets              Budget[]
  pendingTransactions  PendingTransaction[]
  merchantCategoryMaps MerchantCategoryMap[]
  pairingCodes         PairingCode[]
  devices              Device[]
  counterparties       Counterparty[]
  loans                Loan[]
  repayments           Repayment[]
  reminderLogs         ReminderLog[]
  lastCaptureSyncAt    DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@map("users")
}

model Account {
  id           String        @id @default(uuid())
  name         String
  type         AccountType
  balance      Decimal       @default(0) // will ask inital balance while creating an account
  isDefault    Boolean       @default(false)
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([userId])
  @@map("accounts")
}

model Transaction {
  id                String            @id @default(uuid())
  type             TransactionType
  amount           Decimal
  description      String?
  date             DateTime
  category         String           
  receiptUrl       String?
  isRecurring      Boolean           @default(false)
  recurringInterval RecurringInterval? // Only used if isRecurring is true
  nextRecurringDate DateTime?         // Next date for recurring transaction
  lastProcessed    DateTime?         // Last time this recurring transaction was processed
  status           TransactionStatus  @default(COMPLETED)
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId        String
  account          Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([userId])
  @@index([accountId])
  @@map("transactions")
}


model Budget {
  id          String       @id @default(uuid())
  amount      Decimal
  lastAlertSent DateTime?  // Track when the last alert was sent
  userId      String       @unique
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([userId])
  @@map("budgets")
}

model PendingTransaction {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceChannel     String   // 'sms' | 'notification' | 'receipt'
  rawText           String?  // short-lived, only kept until confirmed/discarded
  referenceNumber   String?  // UPI UTR/RRN if present — primary dedup key
  parsedAmount      Float
  parsedDirection   String   // 'credit' | 'debit'
  parsedMerchant    String?
  parsedDate        DateTime
  suggestedCategory String?
  suggestedName     String?
  confidence        String   // 'low' | 'medium' | 'high'
  status            String   @default("pending") // 'pending' | 'confirmed' | 'discarded'
  createdAt         DateTime @default(now())

  @@index([userId, parsedAmount, parsedDate])
  @@index([userId, status])
  @@map("pending_transactions")
}

model MerchantCategoryMap {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchantPattern String   // normalized (lowercase, trimmed) merchant string
  category        String
  updatedAt       DateTime @updatedAt

  @@unique([userId, merchantPattern])
  @@map("merchant_category_maps")
}

model PairingCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String    @unique // short, human-typeable
  expiresAt DateTime // ~10 minutes from creation
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([code])
  @@map("pairing_codes")
}

model Device {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique // HMAC of the device token — never the raw token
  label      String? // e.g. "Android capture app"
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime?
  revoked    Boolean   @default(false)

  @@index([userId])
  @@map("devices")
}

model Counterparty {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  phone     String? // normalized E.164-ish, e.g. +919876543210
  notes     String?
  loans     Loan[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("counterparties")
}

model Loan {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  counterpartyId   String
  // No onDelete override -> defaults to RESTRICT, so the DB itself refuses to
  // delete a Counterparty with existing loans. The app also pre-checks this
  // (see actions/counterparties.js) to return a friendly error instead of a
  // raw FK-violation.
  counterparty     Counterparty  @relation(fields: [counterpartyId], references: [id])
  direction        LoanDirection
  principalAmount  Decimal
  // Denormalized cache for cheap list queries — recomputed from the sum of
  // Repayment rows inside the same transaction as every repayment write.
  // Never trust this as an independent source of truth.
  repaidAmount     Decimal       @default(0)
  // Derived (OPEN/PARTIALLY_REPAID/SETTLED from repaid-vs-principal), stored
  // for cheap filtering, but auto-maintained — never set directly by the UI.
  // OVERDUE is deliberately NOT a stored status: it's computed at read time
  // from dueOn so it can't go stale without a cron.
  status           LoanStatus    @default(OPEN)
  note             String?
  dueOn            DateTime?
  remindersEnabled Boolean       @default(true) // schema seam, not read yet
  lastNudgedAt     DateTime? // set by the manual WhatsApp nudge action
  publicToken      String        @unique // crypto-random, unhashed — a read-only capability link, like PairingCode.code
  repayments       Repayment[]
  reminderLogs     ReminderLog[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([userId, counterpartyId])
  @@index([userId, status])
  @@map("loans")
}

model Repayment {
  id        String   @id @default(cuid())
  loanId    String
  loan      Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  // Denormalized, mirrors Transaction carrying both userId and accountId —
  // lets every query scope by userId directly without an extra join.
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Decimal
  paidOn    DateTime @default(now())
  note      String?
  createdAt DateTime @default(now())

  @@index([loanId])
  @@index([userId])
  @@map("repayments")
}

model ReminderLog {
  id        String   @id @default(cuid())
  loanId    String
  loan      Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Manual nudges always use a fresh key (never blocks a repeat send) — this
  // is a seam for a future automated-reminder cron's deterministic per-day key.
  dedupeKey String   @unique
  channel   String // "whatsapp_manual" for now
  sentAt    DateTime @default(now())

  @@index([loanId])
  @@map("reminder_logs")
}

enum LoanDirection {
  LENT
  BORROWED
}

enum LoanStatus {
  OPEN
  PARTIALLY_REPAID
  SETTLED
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum AccountType {
  CURRENT
  SAVINGS
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum RecurringInterval {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}